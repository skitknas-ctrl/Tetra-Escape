<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="3dp" android:left="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#2A5A4010" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:bottom="3dp" android:right="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#F7F2E6" />
            <stroke android:width="2dp" android:color="#C9A24A" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:bottom="6dp" android:right="5dp" android:top="3dp" android:left="3dp">
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke android:width="1dp" android:color="#66E8D28F" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</layer-list>
