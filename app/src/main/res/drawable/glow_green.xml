<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- soft shadow -->
    <item android:top="10dp" android:left="4dp" android:right="0dp" android:bottom="0dp">
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="50%p" android:startColor="#55000000" android:centerColor="#22000000" android:endColor="#00000000" />
        </shape>
    </item>
    <!-- coloured light cast on the cloth -->
    <item android:top="14dp" android:left="2dp" android:right="2dp" android:bottom="0dp">
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="50%p" android:startColor="#802E9E66" android:endColor="#002E9E66" />
        </shape>
    </item>
</layer-list>
